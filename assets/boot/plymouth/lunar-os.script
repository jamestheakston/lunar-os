Window.SetBackgroundTopColor(0.102, 0.102, 0.180);
Window.SetBackgroundBottomColor(0.055, 0.055, 0.110);

screen.width = Window.GetWidth();
screen.height = Window.GetHeight();
screen.cx = screen.width / 2;
screen.cy = screen.height / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen.cx - logo.image.GetWidth() / 2);
logo.sprite.SetY(screen.cy - logo.image.GetHeight() / 2 - 90);
logo.sprite.SetOpacity(0);

title.image = Image.Text("LUNAR OS", 0.88, 0.88, 0.95, 1, "Sans Bold 26");
title.sprite = Sprite(title.image);
title.sprite.SetX(screen.cx - title.image.GetWidth() / 2);
title.sprite.SetY(screen.cy + 10);
title.sprite.SetOpacity(0);

message.sprite = Sprite();
message.sprite.SetOpacity(0);

fun show_message(text)
{
    image = Image.Text(text, 0.70, 0.70, 0.80, 1, "Sans 12");
    message.sprite.SetImage(image);
    message.sprite.SetX(screen.cx - image.GetWidth() / 2);
    message.sprite.SetY(screen.cy + 150);
}

spinner.count = 8;
spinner.radius = 22;
spinner.cy = screen.cy + 95;
spinner.step = 0;
spinner.frame = 0;

for (i = 0; i < spinner.count; i++)
{
    dot[i].image = Image("dot.png");
    dot[i].sprite = Sprite(dot[i].image);
    angle = 2 * Math.Pi * i / spinner.count;
    dot[i].sprite.SetX(screen.cx + spinner.radius * Math.Sin(angle) - dot[i].image.GetWidth() / 2);
    dot[i].sprite.SetY(spinner.cy - spinner.radius * Math.Cos(angle) - dot[i].image.GetHeight() / 2);
    dot[i].sprite.SetOpacity(0);
}

state.fade = 0;

fun refresh_callback()
{
    state.fade = state.fade + 0.02;
    if (state.fade > 1)
        state.fade = 1;

    logo.sprite.SetOpacity(state.fade);
    title.sprite.SetOpacity(state.fade);
    message.sprite.SetOpacity(state.fade);

    spinner.frame = spinner.frame + 1;
    if (spinner.frame >= 4)
    {
        spinner.frame = 0;
        spinner.step = spinner.step + 1;
    }

    for (i = 0; i < spinner.count; i++)
    {
        distance = (spinner.step - i) % spinner.count;
        if (distance < 0)
            distance = distance + spinner.count;
        dot[i].sprite.SetOpacity(state.fade * (1 - distance / spinner.count) * 0.9 + 0.1 * state.fade);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(text)
{
    show_message(text);
}

Plymouth.SetMessageFunction(message_callback);

fun update_status_callback(status)
{
}

Plymouth.SetUpdateStatusFunction(update_status_callback);

fun display_normal_callback()
{
}

fun display_password_callback(prompt, bullets)
{
    show_message(prompt);
}

fun display_question_callback(prompt, entry)
{
    show_message(prompt + " " + entry);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);

# Don't show message by default - it will be set dynamically
