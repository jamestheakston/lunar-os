#!/bin/bash
set -e

SKEL=/etc/skel

mkdir -p "$SKEL"/{Desktop,Documents,Downloads,Pictures,Music,Videos,Templates}

make_shortcut() {
    local name="$1" icon="$2" command="$3"
    cat > "$SKEL/Desktop/$name.desktop" << ENTRY
[Desktop Entry]
Version=1.0
Type=Application
Name=$name
Icon=$icon
Exec=$command
Terminal=false
ENTRY
    chmod 755 "$SKEL/Desktop/$name.desktop"
}

make_shortcut "Orbit Explorer" system-file-manager "pcmanfm %h"
make_shortcut "Lunar Settings" preferences-system "/usr/share/lunar-os/lunar-settings.py"
make_shortcut "Lunar Store" lunar-store "/usr/share/lunar-os/lunar-store.py"
make_shortcut "Metadata Stripper" edit-clear "/usr/share/lunar-os/lunar-metadata.py"
make_shortcut "Terminal" utilities-terminal "lxterminal"
make_shortcut "Temporary Files" folder-temp "pcmanfm /tmp"
make_shortcut "WireGuard VPN" network-vpn "nm-connection-editor"
