#!/bin/bash
set -e

THEME_DIR=/usr/share/plymouth/themes/lunar-os

if [ ! -f "$THEME_DIR/lunar-os.plymouth" ]; then
    echo "ERROR: Lunar Plymouth theme is missing"
    exit 1
fi

mkdir -p /etc/plymouth
cat > /etc/plymouth/plymouthd.conf << 'CONF'
[Daemon]
Theme=lunar-os
ShowDelay=0
DeviceTimeout=5
CONF

plymouth-set-default-theme -R lunar-os
plymouth-set-default-theme
