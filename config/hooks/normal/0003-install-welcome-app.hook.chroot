#!/bin/bash
set -e

mkdir -p /usr/share/applications /etc/xdg/autostart

cat > /etc/xdg/autostart/lunar-welcome.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Welcome to Lunar OS
Comment=Welcome window for Lunar OS
Exec=/usr/share/lunar-os/welcome.py
Icon=lunar-os
Terminal=false
OnlyShowIn=LXDE;
ENTRY

cat > /usr/share/applications/lunar-welcome.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Welcome to Lunar OS
Comment=About this temporary session
Exec=/usr/share/lunar-os/welcome.py
Icon=lunar-os
Terminal=false
Categories=Utility;
ENTRY

cat > /usr/share/applications/lunar-settings.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Lunar Settings
Comment=Appearance, display, sound, network and session settings
Exec=/usr/share/lunar-os/lunar-settings.py
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;
ENTRY

cat > /usr/share/applications/lunar-store.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Lunar Store
Comment=Install applications and packages
Exec=/usr/share/lunar-os/lunar-store.py
Icon=lunar-store
Terminal=false
Categories=System;PackageManager;
ENTRY

cat > /usr/share/applications/lunar-metadata.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Lunar Metadata Stripper
Comment=Remove hidden metadata from files
Exec=/usr/share/lunar-os/lunar-metadata.py
Icon=edit-clear
Terminal=false
Categories=Utility;Security;
ENTRY

cat > /usr/share/applications/lunar-tour.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Welcome Tour
Comment=Interactive tutorial for first-time users
Exec=/usr/share/lunar-os/lunar-tour.py
Icon=lunar-os
Terminal=false
Categories=System;
ENTRY

cat > /usr/share/applications/lunar-wallpaper.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Wallpaper Gallery
Comment=Choose from multiple wallpapers
Exec=/usr/share/lunar-os/lunar-wallpaper.py
Icon=preferences-desktop-wallpaper
Terminal=false
Categories=Settings;DesktopSettings;
ENTRY

cat > /usr/share/applications/lunar-shortcuts.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Keyboard Shortcuts
Comment=View all keyboard shortcuts
Exec=/usr/share/lunar-os/lunar-shortcuts.py
Icon=input-keyboard
Terminal=false
Categories=System;
ENTRY

cat > /usr/share/applications/lunar-sounds.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=System Sounds
Comment=Configure system notification sounds
Exec=/usr/share/lunar-os/lunar-sounds.py
Icon=audio-card
Terminal=false
Categories=Settings;
ENTRY

cat > /usr/share/applications/lunar-about.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=About Lunar OS
Comment=Version, license, and changelog
Exec=/usr/share/lunar-os/lunar-about.py
Icon=help-about
Terminal=false
Categories=System;
ENTRY

cat > /usr/share/applications/virtualbox-guest-additions.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install VirtualBox Guest Additions
Comment=Install VirtualBox Guest Additions for better VM experience
Exec=lxterminal -e sudo /usr/share/lunar-os/install-vbox-guest-additions.sh
Icon=virtualbox
Terminal=false
Categories=System;Utility;
ENTRY
