#!/bin/bash
set -e

mkdir -p /usr/share/applications /etc/xdg/autostart

cat > /etc/xdg/autostart/lunar-welcome.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Welcome to Lunar OS
Comment=Welcome window for Lunar OS
Exec=/usr/share/lunar-os/welcome.py
Icon=lunar-os
Terminal=false
OnlyShowIn=LXDE;
ENTRY

cat > /usr/share/applications/lunar-welcome.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Welcome to Lunar OS
Comment=About this temporary session
Exec=/usr/share/lunar-os/welcome.py
Icon=lunar-os
Terminal=false
Categories=Utility;
ENTRY

cat > /usr/share/applications/lunar-settings.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Lunar Settings
Comment=Appearance, display, sound, network and session settings
Exec=/usr/share/lunar-os/lunar-settings.py
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;
ENTRY

cat > /usr/share/applications/lunar-start.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Lunar Start
Comment=Lunar OS Start Menu
Exec=/usr/share/lunar-os/lunar-start.py
Icon=lunar-os
Terminal=false
Categories=System;
ENTRY
