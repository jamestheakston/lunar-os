#!/bin/bash
set -e

ASSETS=/tmp/lunar-assets
APP_DIR=/usr/share/lunar-os
WALLPAPER_DIR=/usr/share/backgrounds/lunar-os
THEME_DIR=/usr/share/plymouth/themes/lunar-os
ICON_DIR=/usr/share/icons/hicolor

mkdir -p "$APP_DIR" "$WALLPAPER_DIR"

if [ -f "$ASSETS/desktop/wallpaper.png" ]; then
    install -m 644 "$ASSETS/desktop/wallpaper.png" "$WALLPAPER_DIR/wallpaper.png"
fi

for script in welcome shutdown-dialog lunar-settings lunar-session-monitor lunar-greeter lunar-start; do
    if [ -f "$ASSETS/desktop/$script.py" ]; then
        install -m 755 "$ASSETS/desktop/$script.py" "$APP_DIR/$script.py"
    fi
done

if [ -f "$ASSETS/desktop/welcome-icon.png" ]; then
    install -m 644 "$ASSETS/desktop/welcome-icon.png" "$APP_DIR/welcome-icon.png"
fi

for size in 16 32 48 64 128 256 512; do
    logo="$ASSETS/desktop/logo-${size}x${size}.png"
    if [ -f "$logo" ]; then
        install -D -m 644 "$logo" "$ICON_DIR/${size}x${size}/apps/lunar-os.png"
    fi
done

if [ -d "$ASSETS/plymouth" ]; then
    mkdir -p "$THEME_DIR"
    cp -r "$ASSETS/plymouth/." "$THEME_DIR/"
fi

if [ -d "$ASSETS/icons" ]; then
    cp -r "$ASSETS/icons/." "$ICON_DIR/"
fi

if command -v gtk-update-icon-cache > /dev/null 2>&1; then
    gtk-update-icon-cache -f -t "$ICON_DIR" || true
fi
