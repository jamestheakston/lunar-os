#!/bin/bash
set -e

mkdir -p /etc/lightdm/lightdm.conf.d

cat > /etc/lightdm/lightdm.conf.d/50-lunar.conf << 'CONF'
[Seat:*]
greeter-session=lunar-greeter
user-session=LXDE
autologin-user=lunar
autologin-user-timeout=0
autologin-session=LXDE
CONF

cat > /etc/lightdm/lightdm-gtk-greeter.conf << 'CONF'
[greeter]
background=/usr/share/backgrounds/lunar-os/wallpaper.png
theme-name=Arc-Dark
icon-theme-name=Papirus-Dark
font-name=Sans 10
position=50%,center
CONF

mkdir -p /usr/share/xgreeters

cat > /usr/local/bin/lunar-greeter << 'SCRIPT'
#!/bin/bash
/usr/share/lunar-os/lunar-greeter.py || exec lightdm-gtk-greeter
SCRIPT
chmod 755 /usr/local/bin/lunar-greeter

cat > /usr/share/xgreeters/lunar-greeter.desktop << 'ENTRY'
[Desktop Entry]
Name=Lunar Greeter
Comment=Lunar OS login button
Exec=/usr/local/bin/lunar-greeter
Type=Application
ENTRY

if [ -x /usr/sbin/lightdm ]; then
    echo /usr/sbin/lightdm > /etc/X11/default-display-manager
fi

python3 - << 'PY'
import configparser
import os

path = "/etc/xdg/lxsession/LXDE/desktop.conf"
if not os.path.exists(path):
    print("WARNING: " + path + " not found, GTK theme defaults not set")
else:
    conf = configparser.RawConfigParser(interpolation=None)
    conf.optionxform = str
    conf.read(path)
    if not conf.has_section("GTK"):
        conf.add_section("GTK")
    conf.set("GTK", "sNet/ThemeName", "Arc-Dark")
    conf.set("GTK", "sNet/IconThemeName", "Papirus-Dark")
    conf.set("GTK", "sGtk/FontName", "Sans 10")
    with open(path, "w") as handle:
        conf.write(handle, space_around_delimiters=False)
PY
