#!/bin/bash
set -e

DIALOG=/usr/share/lunar-os/shutdown-dialog.py

write_wrapper() {
    printf '#!/bin/bash\nexec %s %s\n' "$DIALOG" "$2" > "/usr/local/bin/$1"
    chmod 755 "/usr/local/bin/$1"
}

write_wrapper lunar-shutdown ""
write_wrapper lunar-restart "--restart"
write_wrapper lunar-logout "--logout"

for tool in lxsession-logout lxde-logout; do
    path="/usr/bin/$tool"
    if [ -e "$path" ] && ! dpkg-divert --list | grep -q "diversion of $path to"; then
        dpkg-divert --local --rename --divert "$path.real" --add "$path"
    fi
    if [ -e "$path.real" ] || [ ! -e "$path" ]; then
        printf '#!/bin/bash\nexec /usr/local/bin/lunar-shutdown\n' > "$path"
        chmod 755 "$path"
    fi
done

mkdir -p /usr/share/applications

cat > /usr/share/applications/lunar-shutdown.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Shut Down
Comment=Shut down, restart or log out
Icon=system-shutdown
Exec=/usr/local/bin/lunar-shutdown
Terminal=false
Categories=System;
ENTRY

cat > /usr/share/applications/lunar-restart.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Restart and Start Fresh
Icon=system-reboot
Exec=/usr/local/bin/lunar-restart
Terminal=false
Categories=System;
ENTRY

cat > /usr/share/applications/lunar-logout.desktop << 'ENTRY'
[Desktop Entry]
Version=1.0
Type=Application
Name=Log Out
Icon=system-log-out
Exec=/usr/local/bin/lunar-logout
Terminal=false
Categories=System;
ENTRY
