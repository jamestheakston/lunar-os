#!/bin/bash
set -e

if [ -d /etc/firefox-esr ]; then
    cat > /etc/firefox-esr/lunar.js << 'PREFS'
pref("browser.privatebrowsing.autostart", true);
pref("privacy.trackingprotection.enabled", true);
pref("privacy.trackingprotection.pbmode.enabled", true);
pref("browser.download.dir", "/home/lunar/Downloads");
pref("browser.download.folderList", 2);
pref("browser.cache.disk.enable", false);
pref("browser.cache.memory.enable", true);
pref("browser.sessionstore.resume_from_crash", false);
pref("browser.sessionstore.max_tabs_undo", 0);
pref("browser.sessionstore.max_windows_undo", 0);
PREFS
fi

mkdir -p /etc/xdg/lxterminal
cat > /etc/xdg/lxterminal/lxterminal.conf << 'CONF'
[general]
fontname=Monospace 10
bgcolor=rgb(0,0,0)
fgcolor=rgb(255,255,255)
cursorblinks=true
CONF

PCMANFM_CONF=/etc/xdg/pcmanfm/LXDE/pcmanfm.conf
mkdir -p "$(dirname "$PCMANFM_CONF")"
touch "$PCMANFM_CONF"
if grep -q '^quick_exec=' "$PCMANFM_CONF"; then
    sed -i 's/^quick_exec=.*/quick_exec=1/' "$PCMANFM_CONF"
elif grep -q '^\[config\]' "$PCMANFM_CONF"; then
    sed -i '/^\[config\]/a quick_exec=1' "$PCMANFM_CONF"
else
    printf '[config]\nquick_exec=1\n' >> "$PCMANFM_CONF"
fi
