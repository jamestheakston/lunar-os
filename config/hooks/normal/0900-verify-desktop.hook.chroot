#!/bin/bash
set -e

missing=0

for pkg in lxde-core lightdm openbox firefox-esr pcmanfm lxterminal mousepad galculator gpicview lxtask dunst picom plymouth gnome-themes-extra arc-theme papirus-icon-theme gir1.2-gtk-3.0 network-manager-gnome; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2> /dev/null | grep -q 'install ok installed'; then
        echo "ERROR: required package $pkg is not installed"
        missing=1
    fi
done

for file in \
    /usr/sbin/lightdm \
    /usr/bin/startlxde \
    /usr/share/xsessions/LXDE.desktop \
    /usr/share/lunar-os/welcome.py \
    /usr/share/lunar-os/shutdown-dialog.py \
    /usr/share/lunar-os/lunar-settings.py \
    /usr/share/lunar-os/lunar-session-monitor.py \
    /usr/share/lunar-os/lunar-greeter.py \
    /usr/share/lunar-os/lunar-start7.py \
    /usr/share/lunar-os/lunar-store.py \
    /usr/share/lunar-os/start-orb.png \
    /usr/share/xgreeters/lunar-greeter.desktop \
    /usr/local/bin/lunar-shutdown \
    /usr/share/plymouth/themes/lunar-os/lunar-os.script \
    /usr/share/plymouth/themes/lunar-os/logo.png \
    /usr/share/backgrounds/lunar-os/wallpaper.png \
    /usr/share/themes/Lunar/openbox-3/themerc \
    /etc/xdg/lxpanel/LXDE/panels/panel; do
    if [ ! -e "$file" ]; then
        echo "ERROR: $file is missing"
        missing=1
    fi
done

if ! python3 -c "import gi; gi.require_version('LightDM', '1'); from gi.repository import LightDM"; then
    echo "ERROR: PyGObject cannot load LightDM"
    missing=1
fi

if ! python3 -c "import gi; gi.require_version('Gtk', '3.0'); from gi.repository import Gtk"; then
    echo "ERROR: PyGObject cannot load GTK 3"
    missing=1
fi

for script in welcome shutdown-dialog lunar-settings lunar-session-monitor lunar-greeter lunar-start7 lunar-store; do
    if ! python3 -c "import ast, sys; ast.parse(open(sys.argv[1]).read())" "/usr/share/lunar-os/$script.py"; then
        echo "ERROR: $script.py does not compile"
        missing=1
    fi
done

RC=""
for candidate in /etc/xdg/openbox/LXDE/rc.xml /etc/xdg/openbox/LXDE-rc.xml; do
    if [ -f "$candidate" ]; then
        RC="$candidate"
        break
    fi
done

if [ -z "$RC" ]; then
    RC="$(find /etc/xdg/openbox -name 'rc.xml' -o -name '*-rc.xml' 2> /dev/null | head -n 1)"
fi

if [ -z "$RC" ]; then
    echo "ERROR: no Openbox rc.xml found"
    missing=1
else
    if ! grep -q '<name>Lunar</name>' "$RC"; then
        echo "ERROR: Lunar Openbox theme is not active in $RC"
        missing=1
    fi
    if ! grep -q 'lunar-shutdown' "$RC"; then
        echo "ERROR: Lunar keyboard shortcuts are not installed in $RC"
        missing=1
    fi
fi

if ! grep -q 'Adwaita-dark' /etc/xdg/lxsession/LXDE/desktop.conf 2> /dev/null; then
    echo "WARNING: dark theme not set in /etc/xdg/lxsession/LXDE/desktop.conf"
fi

if ! grep -q 'Lunar OS' /etc/os-release; then
    echo "ERROR: os-release still carries the original branding"
    missing=1
fi

if ! grep -q 'private-window' /usr/share/applications/firefox-esr.desktop; then
    echo "ERROR: Firefox is not set to launch in private mode"
    missing=1
fi

for entry in /usr/share/applications/*.desktop; do
    case "$entry" in
        */firefox-esr.desktop | */lunar-*) continue ;;
    esac
    if grep -q -E '^Categories=.*WebBrowser' "$entry"; then
        echo "ERROR: extra web browser entry $entry"
        missing=1
    fi
done

exit "$missing"
