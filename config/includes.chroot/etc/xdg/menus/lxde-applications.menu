<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<Menu>
  <Name>Applications</Name>
  <MergeFile type="parent">/etc/xdg/menus/lxde-applications.menu</MergeFile>
  
  <Menu>
    <Name>Lunar OS</Name>
    <Directory>lunar-os.directory</Directory>
    <Include>
      <Filename>lunar-settings.desktop</Filename>
      <Filename>lunar-store.desktop</Filename>
      <Filename>lunar-metadata.desktop</Filename>
      <Filename>lunar-welcome.desktop</Filename>
      <Filename>lunar-tour.desktop</Filename>
      <Filename>lunar-wallpaper.desktop</Filename>
      <Filename>lunar-shortcuts.desktop</Filename>
      <Filename>lunar-sounds.desktop</Filename>
      <Filename>lunar-about.desktop</Filename>
    </Include>
  </Menu>
  
  <Menu>
    <Name>Accessories</Name>
    <Directory>lxde-utility.directory</Directory>
    <Menu>
      <Name>Virtualization</Name>
      <Directory>lunar-virtualization.directory</Directory>
      <Include>
        <Filename>virtualbox-guest-additions.desktop</Filename>
      </Include>
    </Menu>
  </Menu>
</Menu>
</Menu>
