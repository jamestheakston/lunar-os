Global {
    edge=bottom
    allign=left
    margin=0
    widthtype=percent
    width=100
    height=48
    transparent=0
    tintcolor=#000000
    alpha=0
    autohide=0
    heightwhenhidden=2
    setdocktype=1
    setpartialstrut=1
    usefontcolor=0
    fontsize=11
    usefontsize=0
    background=0
    backgroundfile=/usr/share/lxpanel/images/background.png
    iconsize=32
    loglevel=2
}
Plugin {
    type=space
    Config {
        Size=4
    }
}
Plugin {
    type=launchbar
    Config {
        Button {
            id=lunar-start7.desktop
        }
    }
}
Plugin {
    type=space
    Config {
        Size=6
    }
}
Plugin {
    type=launchbar
    Config {
        Button {
            id=pcmanfm.desktop
        }
        Button {
            id=firefox-esr.desktop
        }
        Button {
            id=lxterminal.desktop
        }
        Button {
            id=lunar-store.desktop
        }
        Button {
            id=lunar-metadata.desktop
        }
        Button {
            id=lunar-settings.desktop
        }
    }
}
Plugin {
    type=space
    Config {
        Size=8
    }
}
Plugin {
    type=taskbar
    expand=1
    Config {
        tooltips=1
        IconsOnly=0
        ShowAllDesks=0
        UseMouseWheel=1
        UseUrgencyHint=1
        FlatButton=0
        MaxTaskWidth=160
        spacing=2
        GroupedTasks=0
    }
}
Plugin {
    type=tray
}
Plugin {
    type=volumealsa
}
Plugin {
    type=batt
}
Plugin {
    type=dclock
    Config {
        ClockFmt=%a %d %b  %H:%M
        TooltipFmt=%A %x
        BoldFont=0
        IconOnly=0
        CenterText=0
    }
}
Plugin {
    type=launchbar
    Config {
        Button {
            id=lunar-shutdown.desktop
        }
    }
}
