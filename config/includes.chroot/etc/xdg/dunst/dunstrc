[global]
    monitor = 0
    follow = mouse
    width = (0, 360)
    height = 200
    origin = top-right
    offset = 16x16
    notification_limit = 5
    padding = 12
    horizontal_padding = 14
    separator_height = 2
    frame_width = 1
    frame_color = "#6c5ce7"
    separator_color = frame
    corner_radius = 8
    font = Sans 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    icon_position = left
    max_icon_size = 48
    sticky_history = no
    history_length = 20

[urgency_low]
    background = "#1a1a2e"
    foreground = "#c8c8d8"
    timeout = 5

[urgency_normal]
    background = "#1a1a2e"
    foreground = "#e8e8f0"
    timeout = 8

[urgency_critical]
    background = "#2a1a2e"
    foreground = "#ffffff"
    frame_color = "#e74c3c"
    timeout = 0
