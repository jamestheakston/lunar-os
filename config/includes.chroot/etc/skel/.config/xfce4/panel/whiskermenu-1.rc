# Lunar OS Whisker Menu Configuration
[launcher]
favorites=exo-terminal-emulator.desktop,exo-file-manager.desktop,firefox-esr.desktop,mousepad.desktop,galculator.desktop
recent=exo-terminal-emulator.desktop,exo-file-manager.desktop,firefox-esr.desktop,system-monitor.desktop,ristretto.desktop

[settings]
button-icon=lunar-logo
button-single-row=false
category-hover-switch=true
category-icon-size=2
command-settings=
command-terminal=exo-open --launch TerminalEmulator
command-sudo=sudo
command-lockscreen=xflock4
command-logout=xfce4-session-logout
command-menueditor=menulibre
command-profile=simple-menu-profile-editor
search-actions=5

[position]
launcher-name=Menu
menu-width=450
menu-height=550
position-alignment=center
position-offset-x=0
position-offset-y=0

[appearance]
item-icon-size=2
category-icon-size=2
category-show-name=true
favorites-in-recent=true
position-search-alternate=false
position-commands-alternate=false
position-categories-alternate=false
position-categories-horizontal=false
stay-on-focus-out=false
profile-shape=0
compact-menu-item-height=2

[behavior]
search-case-sensitive=false
filter-profiles=false
filter-lock-screen=false
filter-logout=false
filter-settings=true
filter-commands=false
hover-switch-category=true
launch-in-terminal=false
position-commands-bottom=true
position-categories-alternate=false
position-search-alternate=false
show-generic-names=true
show-tooltips=true
flat-noduplicates=true
show-hidden=false
