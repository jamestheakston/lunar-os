#!/bin/bash
# Hook to configure built-in applications for Lunar OS

set -e

echo "Configuring built-in applications..."

# Configure Firefox for disposable session
# This sets Firefox to use private browsing mode by default
if [ -d /usr/lib/firefox-esr ]; then
    cat > /etc/firefox-esr/syspref.js << 'EOF'
// Lunar OS Firefox Configuration
// Private browsing mode for disposable sessions

pref("browser.privatebrowsing.autostart", true);
pref("browser.privatebrowsing.force-new", true);
pref("privacy.trackingprotection.enabled", true);
pref("privacy.trackingprotection.pbmode.enabled", true);
pref("browser.download.dir", "/home/lunar/Downloads");
pref("browser.download.folderList", 2);
pref("browser.cache.disk.enable", false);
pref("browser.cache.memory.enable", true);
pref("browser.cache.memory.capacity", 65536);
pref("browser.sessionstore.resume_from_crash", false);
pref("browser.sessionstore.max_tabs_undo", 0);
pref("browser.sessionstore.max_windows_undo", 0);
EOF
fi

# Configure Thunar (file manager) defaults
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar.xml << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="thunar" version="1.0">
  <property name="last-view" type="string" value="ThunarIconView"/>
  <property name="last-icon-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_100_PERCENT"/>
  <property name="last-separator-position" type="int" value="170"/>
  <property name="last-show-hidden" type="bool" value="false"/>
  <property name="last-details-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_100_PERCENT"/>
  <property name="last-details-view-column-widths" type="array">
    <value type="int" value="50"/>
    <value type="int" value="150"/>
    <value type="int" value="75"/>
    <value type="int" value="75"/>
    <value type="int" value="100"/>
    <value type="int" value="75"/>
    <value type="int" value="75"/>
    <value type="int" value="75"/>
  </property>
  <property name="misc-volume-mount" type="empty">
    <property name="external-disk" type="empty">
      <property name="mount-removable" type="bool" value="true"/>
    </property>
  </property>
</channel>
EOF

# Configure XFCE Terminal defaults
mkdir -p /etc/xdg/xfce4/terminal
cat > /etc/xdg/xfce4/terminal/terminalrc << 'EOF'
[Configuration]
FontName=Monospace 10
MiscDefaultGeometry=80x24
MiscToolbarDefault=ToolbarDefault
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBellFull=FALSE
MiscBlinkingCursor=FALSE
MiscCursorBlinks=FALSE
MiscCursorShape=block
MiscDefaultWorkingDir=$HOME
MiscConfirmClose=TRUE
MiscCycleTabs=TRUE
MiscCursorShape=block
MiscDefaultGeometry=80x24
MiscMouseAutohide=FALSE
MiscToolbarsBrowser=TRUE
MiscMenuVisibility=TRUE
MiscToolbarDefault=TRUE
MiscShowReliefDialog=TRUE
MiscMiddleClickEmulates=FALSE
MiscCopyOnSelect=FALSE
MiscRewrapOnResize=TRUE
EOF

echo "Applications configured"
